# ==============================================================================
# DEPOTBOX MANIFEST & LUA API CONFIGURATION
# ==============================================================================

# [Required] Your DepotBox Session Cookie (connect.sid)
# Obtain this from your browser cookies while logged into https://depotbox.org/
# (Your account MUST be a Premium member on DepotBox to bypass CAPTCHA checks)
DEPOTBOX_COOKIE=your_connect_sid_cookie_here

# [Optional] Master Secret used to cryptographically derive and sign API keys.
# If left blank, the API server will automatically derive a consistent secret
# from the hash of your DEPOTBOX_COOKIE.
API_MASTER_SECRET=

# [Optional] Comma-separated list of pre-authorized static API keys (e.g. for legacy bots or tools)
STATIC_API_KEYS=smm_a71e5b41486ac4162ef91f3d9637cb4946620b1a398b5b3f1543e366324d6795c085f4bc243a5b156a3502053a66ea82

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Rate Limiting (Requests per minute per API key)
RATE_LIMIT_PER_MINUTE=60

# Cache Storage Settings
CACHE_DIR=./cache_storage
ENABLE_CACHE=true

# Enable Fallback to SteamCMD and Public GitHub Manifest Mirrors if DepotBox is offline
ENABLE_FALLBACK_MIRRORS=true
