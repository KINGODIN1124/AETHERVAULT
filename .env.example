# ==============================================================================
# AETHERVAULT MANIFEST & LUA DISTRIBUTION GATEWAY CONFIGURATION
# ==============================================================================

# [Required] Upstream Master Session Cookie (connect.sid)
# Your session cookie from the upstream engine.
UPSTREAM_SESSION_COOKIE=s%3Ayour_connect_sid_cookie_here

# [Optional] Upstream Account Credentials for Automated Session Auto-Refresh
# When the session cookie expires, AetherVault automatically logs in headlessly,
# retrieves the fresh cookie, and syncs it without dropping API requests!
UPSTREAM_EMAIL=
UPSTREAM_PASSWORD=

# [Optional] Master Secret used to cryptographically derive and sign API keys.
# If left blank, AetherVault automatically derives a consistent secret from the session.
API_MASTER_SECRET=

# [Optional] Discord Bot Token (for /claimkey bot giving users 1-month API keys)
DISCORD_TOKEN=
API_PUBLIC_URL=http://your-server-ip:8000

# Server Settings
HOST=0.0.0.0
PORT=8000

# Anti-Scraping Defense & Rate Limits
ENABLE_ANTI_SCRAPING=true
PUBLIC_DAILY_LIMIT=30
DISCORD_DAILY_LIMIT=150
BURST_LIMIT_PER_SECOND=5
BAN_DURATION_HOURS=24

# Cache & Redundancy
CACHE_DIR=./cache_storage
ENABLE_CACHE=true
ENABLE_FALLBACK_MIRRORS=true
